#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = [
#   "pyobjc-framework-Cocoa; sys_platform == 'darwin'",
#   "PyGObject; sys_platform == 'linux'",
#   "pycairo; sys_platform == 'linux'",
# ]
# ///
"""A tray dot per running Claude Code instance, and a panel that jumps to one.

The icon is one dot per instance in the smallest square grid that holds them all. Opening
it lists every one of them: type to filter, 1-0 or enter to jump, escape to close. The
listing, the ordering, the fuzzy filter and the jump are claudes.py, the same ones the TUI
uses; the state, the palette and the layout are systray.py. So this file is the launching,
and each platform's own drawing is behind it in systray_mac.py or systray_linux.py.

Unlike the TUI, jumping closes the panel: this is a launcher you called up to leave, not a
window you are already sitting in.

    ./ccx-systray              # starts it and gives the prompt back
    ./ccx-systray --foreground # stays attached, for a traceback you can see
    ./ccx-systray --show       # opens the panel at launch, to look at it from a script
    ./ccx-systray --toggle     # opens or closes the running one (Linux; see below)

macOS has a global hotkey of its own, ^⌥⌘J, registered with Carbon. Wayland has no such
thing: the compositor owns the keyboard and an application cannot ask it for a shortcut,
so on Linux the hotkey is a niri bind that runs `--toggle`:

    Mod+J repeat=false hotkey-overlay-title="ccx" {
        spawn "/home/fserb/prj/ccx/ccx-systray" "--toggle";
    }
"""

import os
import signal
import subprocess
import sys

from claudes import MAC, processes

LOG = "/tmp/ccx-systray.log"
PIDFILE = "/tmp/ccx-systray.pid"
CHILD = "CCX_SYSTRAY_CHILD"


def running_pid():
    """The pid of an instance already running, or None.

    Two copies means two tray items and two bells, which is easy to do by accident now
    that starting it gives the prompt straight back. The pid in the file could have been
    reused by anything since, so what it is running is checked too, which also means a
    stale file needs no cleaning up: the app can be killed in ways that run no exit code.
    """
    try:
        pid = int(open(PIDFILE).read())
        os.kill(pid, 0)
    except (OSError, ValueError):
        return None
    return pid if "ccx-systray" in processes().get(pid, (0, ""))[1] else None


def detach():
    """Relaunch ourselves in a new session, so closing the terminal does not take the app.

    An exec rather than a bare fork: neither Cocoa nor GTK is fork-safe and the toolkit is
    imported by the time this runs, so a forked child would die on its first call into it.
    start_new_session is setsid(), which is what leaves the app with no controlling
    terminal, the case claudes.send_kitty()'s tty argument exists for. Output goes to a
    log, since a detached process with a traceback has nowhere else to put it.
    """
    log = open(LOG, "a")
    child = subprocess.Popen([sys.executable, os.path.abspath(__file__), *sys.argv[1:]],
                             env=os.environ | {CHILD: "1"}, start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=log, stderr=log)
    print(f"ccx-systray running as pid {child.pid}  (log: {LOG})")


def toggle():
    """Open or close the panel of the running instance. The Linux hotkey's whole job.

    SIGUSR1 rather than a socket: the only message this ever has to carry is "you", and a
    signal needs nothing listening on the other end to be set up or cleaned up. macOS
    does not take this path, and must not: nothing there installs a handler, and SIGUSR1's
    default action would kill the app instead of showing it.
    """
    if MAC:
        sys.exit("--toggle is for Linux; on macOS press the hotkey, ^⌥⌘J")
    if not (pid := running_pid()):
        sys.exit("ccx-systray is not running")
    os.kill(pid, signal.SIGUSR1)


def main():
    if "--toggle" in sys.argv:
        toggle()
        return
    if pid := running_pid():
        sys.exit(f"ccx-systray is already running as pid {pid}")
    if "--foreground" not in sys.argv and not os.environ.get(CHILD):
        detach()
        return
    open(PIDFILE, "w").write(str(os.getpid()))

    if MAC:
        import systray_mac as backend
    else:
        import systray_linux as backend
    backend.run(sys.argv[1:])


if __name__ == "__main__":
    main()
