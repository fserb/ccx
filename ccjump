#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["textual"]
# ///
"""Pick a running Claude Code instance and focus its kitty window + tmux pane.

Mapping chain, verified on this setup:

    claude pid --(walk ppid)--> tmux pane_pid --> session --> client_pid --> kitty window

The tmux client is a direct child of kitty (`zsh -l -c tmux` execs tmux), so the client
pid is the kitty window's own child pid and `match pid:N` identifies the window.
"""

import contextlib
import json
import os
import re
import subprocess
import sys
import termios
import time
from dataclasses import dataclass

HOME = os.path.expanduser("~")

# --------------------------------------------------------------------------- work

def sh(*args, timeout=4):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return r.stdout if r.returncode == 0 else ""
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return ""


@dataclass
class Instance:
    pid: int
    pane: str = ""
    session: str = ""
    window: str = ""
    pane_index: str = ""
    tab: str = ""            # window index, only when the session holds >1 claude
    path: str = ""
    summary: str = ""
    state: str = "idle"
    last_write: float = 0    # epoch claude last wrote to its session log
    since: float = 0.0       # epoch this instance entered its current state
    client_tty: str = ""
    client_pid: str = ""

    @property
    def match(self):
        return f"pid:{self.client_pid}" if self.client_pid else None

    @property
    def short_path(self):
        path = self.path.replace(HOME, "~") if self.path else "?"
        return f"{path}:{self.tab}" if self.tab else path

    @property
    def age(self):
        return fmt_age(time.time() - self.since) if self.since else "?"


def fmt_age(seconds):
    seconds = max(0, int(seconds))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    return f"{seconds // 3600}h"


def last_write(path):
    """When claude last wrote a message for this cwd, from its session log's mtime.

    tmux's `window_activity` looks like the obvious source and is useless: Claude's TUI
    repaints constantly, so an idle pane still reports activity ~now. The session log is
    only appended on real messages.
    """
    slug = re.sub(r"[^A-Za-z0-9]", "-", path)
    try:
        entries = os.scandir(f"{HOME}/.claude/projects/{slug}")
        return max(e.stat().st_mtime for e in entries if e.name.endswith(".jsonl"))
    except (OSError, ValueError):
        return 0


class StateClock:
    """When each instance entered its current state.

    Seeded from the session log on first sight, which is accurate for an instance that is
    sitting idle or waiting. Transitions seen while the app runs are timed directly.
    """

    def __init__(self):
        self.seen = {}

    def update(self, instances):
        now = time.time()
        for i in instances:
            state, since = self.seen.get(i.pid, (None, None))
            i.since = (i.last_write or now) if state is None else (since if state == i.state else now)
            self.seen[i.pid] = (i.state, i.since)
        live = {i.pid for i in instances}
        self.seen = {pid: v for pid, v in self.seen.items() if pid in live}
        return instances


IS_CLAUDE = re.compile(r"(^|/)claude(\s|$)|\.claude/local/.*cli\.js")
PS_LINE = re.compile(r"\s*(\d+)\s+(\d+)\s+(.*)")


def processes():
    table = {}
    for line in sh("ps", "-axo", "pid=,ppid=,command=").splitlines():
        if m := PS_LINE.match(line):
            table[int(m[1])] = (int(m[2]), m[3])
    return table


def tmux_rows(subcommand, fields, *extra):
    fmt = "\t".join(f"#{{{f}}}" for f in fields)
    out = sh("tmux", subcommand, *extra, "-F", fmt)
    return [dict(zip(fields, line.split("\t"))) for line in out.splitlines() if line]


def capture(pane, lines=40):
    return sh("tmux", "capture-pane", "-p", "-t", pane, "-S", f"-{lines}")


def pane_state(text):
    if re.search(r"Do you want|Would you like|❯ 1\.", text):
        return "waiting"
    if "esc to interrupt" in text:
        return "busy"
    return "idle"


def discover():
    procs = processes()
    panes = tmux_rows("list-panes", ["session_name", "window_index", "pane_index", "pane_id",
                                     "pane_pid", "pane_current_path", "pane_title"], "-a")
    clients = tmux_rows("list-clients", ["client_tty", "client_pid", "client_session"])
    pane_by_pid = {int(p["pane_pid"]): p for p in panes}
    client_by_session = {c["client_session"]: c for c in clients}

    found = []
    for pid, (_, cmd) in procs.items():
        if not IS_CLAUDE.search(cmd):
            continue
        pane, cur = None, pid
        for _ in range(12):                      # walk up to the owning pane
            if cur in pane_by_pid:
                pane = pane_by_pid[cur]
                break
            if cur not in procs:
                break
            cur = procs[cur][0]
        if not pane:
            found.append(Instance(pid=pid, summary=cmd, state="idle"))
            continue
        client = client_by_session.get(pane["session_name"], {})
        found.append(Instance(
            pid=pid,
            pane=pane["pane_id"],
            session=pane["session_name"],
            window=pane["window_index"],
            pane_index=pane["pane_index"],
            path=pane["pane_current_path"],
            summary=pane["pane_title"].lstrip("✳✶✻✽* ·") or "claude",
            state=pane_state(capture(pane["pane_id"])),
            last_write=last_write(pane["pane_current_path"]),
            client_tty=client.get("client_tty", ""),
            client_pid=client.get("client_pid", ""),
        ))
    tag_tabs(found)
    return sorted(found, key=lambda i: (i.short_path, i.pid))


def tag_tabs(found):
    """Tab suffix for the path, but only where it disambiguates.

    One kitty window shows one tmux window at a time, so the tab number only matters when
    a session holds more than one claude. Two in the same window get `:N.M` with the pane.
    """
    for i in found:
        peers = [p for p in found if p.session and p.session == i.session]
        if len(peers) < 2:
            continue
        same_window = [p for p in peers if p.window == i.window]
        i.tab = f"{i.window}.{i.pane_index}" if len(same_window) > 1 else i.window


# `kitten @` writes a bare `ESC P @kitty-cmd {...} ESC \` to the tty. tmux forwards only
# `ESC P tmux; ... ESC \`, so the bare form is swallowed and the command never reaches
# kitty (silently, with --no-response). So build the sequence here and wrap it.
KITTY_RC_VERSION = [0, 26, 0]


def send_kitty(command, payload):
    msg = {"cmd": command, "version": KITTY_RC_VERSION, "no_response": True,
           "payload": payload}
    if wid := os.environ.get("KITTY_WINDOW_ID"):
        msg["kitty_window_id"] = int(wid)
    seq = f"\x1bP@kitty-cmd{json.dumps(msg, separators=(',', ':'))}\x1b\\"
    if os.environ.get("TMUX"):
        seq = f"\x1bPtmux;{seq.replace(chr(27), chr(27) * 2)}\x1b\\"
    try:
        with open("/dev/tty", "w") as tty:
            tty.write(seq)
            tty.flush()
        return True
    except OSError as e:
        print(f"cannot write to /dev/tty: {e}", file=sys.stderr)
        return False


def jump(inst):
    """Focus the instance. Returns an error message, or None when it worked."""
    if not inst.pane:
        return f"pid {inst.pid} is not inside tmux; nothing to focus"
    if inst.client_tty:
        sh("tmux", "switch-client", "-c", inst.client_tty, "-t", inst.session)
    elif os.environ.get("TMUX"):
        sh("tmux", "switch-client", "-t", inst.session)
    sh("tmux", "select-window", "-t", f"{inst.session}:{inst.window}")
    sh("tmux", "select-pane", "-t", inst.pane)
    if inst.match:
        send_kitty("focus-window", {"match": inst.match})
    if sys.platform == "darwin":
        sh("open", "-a", "kitty")
    return None


# quitting calls os._exit (see App.action_quit), which skips every `finally`, so anything
# that has to run before the process dies registers itself here
ON_EXIT = []


@contextlib.contextmanager
def tmux_window_name(name):
    """Name our own tmux window for as long as the app runs.

    tmux's automatic-rename uses the pane's foreground command, and the `uv run --script`
    shebang keeps uv as that process, so the tab reads `uv`. `allow-rename` is off by
    default, so the ESC k escape is ignored and only `rename-window` works; it also turns
    automatic-rename off for the window, hence the restore.
    """
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        yield
        return
    was = sh("tmux", "display-message", "-p", "-t", pane,
             "#{automatic-rename}\t#{window_name}").strip()
    sh("tmux", "rename-window", "-t", pane, name)

    def restore():
        auto, _, before = was.partition("\t")
        if auto == "1" or not before:
            sh("tmux", "set-window-option", "-t", pane, "automatic-rename", "on")
        else:
            sh("tmux", "rename-window", "-t", pane, before)

    ON_EXIT.append(restore)
    try:
        yield
    finally:
        ON_EXIT.remove(restore)
        restore()


@contextlib.contextmanager
def kitty_window_title(name):
    """Name our own kitty window (what the tab bar shows) for as long as the app runs.

    tmux ships with `set-titles off`, so nothing inside a pane ever writes a title and
    kitty falls back to its own default, the foreground process, which reads `uv` for the
    same reason the tmux tab does. Setting it without `temporary` makes it permanent, so
    it also survives a config with `set-titles on`; sending the command with no title at
    all is what puts kitty's default back.

    Target the window by the pid of the tmux client attached to our session, the same
    `pid:N` match jump() uses. KITTY_WINDOW_ID cannot be trusted here: inside a pane it is
    inherited from the environment the tmux *server* started in, so it can name a window
    that closed long ago.
    """
    target = {}
    if os.environ.get("TMUX"):
        pid = sh("tmux", "display-message", "-p", "#{client_pid}").strip()
        if not pid:                          # no client attached, so no window to name
            yield
            return
        target = {"match": f"pid:{pid}"}
    send_kitty("set-window-title", target | {"title": name})

    def restore():
        send_kitty("set-window-title", target)     # no title: back to kitty's default

    ON_EXIT.append(restore)
    try:
        yield
    finally:
        ON_EXIT.remove(restore)
        restore()


# ----------------------------------------------------------------------------- ui

from textual.app import App, ComposeResult          # noqa: E402
from textual.binding import Binding                 # noqa: E402
from textual.containers import Horizontal           # noqa: E402
from textual.theme import Theme                     # noqa: E402
from textual.widgets import DataTable, Rule, Static  # noqa: E402
from rich.text import Text                          # noqa: E402

# Built from ~/.config/kitty/kitty.conf so the app matches the terminal it runs in:
# color13 #ceaadf (bright purple), color5 #b8a0be (mauve), background #000.
PURPLE = Theme(
    name="ccjump",
    primary="#ceaadf",
    secondary="#b8a0be",
    accent="#ceaadf",
    foreground="#eeeeee",
    background="#000000",
    surface="#0e0b12",
    panel="#181020",
    warning="#eccd58",
    error="#df6565",
    success="#c4d15b",
    dark=True,
)

STATE = {
    "waiting": ("● wait", "bold #ceaadf"),
    "busy": ("◐ busy", "#80c9be"),
    "idle": ("○ idle", "#626262"),
}
STATE_ORDER = {"idle": 0, "waiting": 1, "busy": 2}
SORTS = ("state", "path")
KEY = "bold #ceaadf"
KEYS = Text.assemble(("enter", KEY), " jump   ", ("esc", KEY), " quit   ", ("^s", KEY), " sort")


def fuzzy(needle, hay):
    """Subsequence match. Returns (score, matched indices) or None; lowest score wins.

    Greedy forward to prove the match exists, then greedy backward from the last hit,
    which pulls the matched characters as far right as they will go and so collapses
    "ccj" onto the `ccj` in ccjump instead of scattering it over ~/prj/wrangler.
    Every character skipped costs 2, or 1 when the match lands on a word start, so a
    match at the head of a path segment beats one buried mid-word."""
    low = hay.lower()
    idx, at = [], 0
    for c in needle:
        at = low.find(c, at)
        if at < 0:
            return None
        idx.append(at)
        at += 1
    for n in range(len(idx) - 2, -1, -1):
        idx[n] = low.rfind(needle[n], 0, idx[n + 1])
    score = 0
    for n, i in enumerate(idx):
        gap = i - idx[n - 1] - 1 if n else i
        score += gap * (1 if i == 0 or not hay[i - 1].isalnum() else 2)
    return score, idx


class Table(DataTable):
    BINDINGS = [Binding("enter", "select_cursor", "jump", show=True)]

    def on_click(self, event):
        """Select on the first click. DataTable moves the cursor on click and only
        selects on a second click; its own `_on_click` has already run by now, so the
        cursor is on the clicked row. Cell meta carries row -1 for the header."""
        if event.style.meta.get("row", -1) >= 0:
            self.action_select_cursor()


class CCJump(App):
    CSS = """
    Screen { background: $background; }
    #bar { height: 1; background: $panel; }
    #search { width: 1fr; padding: 0 1; }
    #status { width: auto; padding: 0 2; color: $secondary; }
    #keys { width: auto; padding: 0 1; }
    Rule { height: 1; margin: 0; color: #35284a; }
    Table { height: 1fr; padding: 0 1; background: $background; scrollbar-size-horizontal: 0; }
    Table > .datatable--cursor { background: #2a1e38; text-style: bold; }
    Table > .datatable--header { background: $background; color: $secondary; }
    """
    ENABLE_COMMAND_PALETTE = False
    BINDINGS = [
        Binding("escape", "quit", "quit"),
        Binding("ctrl+s", "cycle_sort", "sort"),
    ]

    def __init__(self):
        super().__init__()
        self.clock = StateClock()
        self.instances = []
        self.rows = []
        self.filter = ""
        self.sort = SORTS[0]

    def compose(self) -> ComposeResult:
        with Horizontal(id="bar"):
            yield Static(id="search")
            yield Static(id="status")
            yield Static(KEYS, id="keys")
        yield Rule(line_style="solid")
        yield Table(cursor_type="row", zebra_stripes=False)

    def on_mount(self):
        self.register_theme(PURPLE)
        self.theme = "ccjump"
        table = self.query_one(Table)
        table.add_column("state", width=6)
        table.add_column("for", width=5)
        table.add_column("path", width=26)
        table.add_column("summary")
        self.reload()
        self.set_interval(1.5, self.reload)

    def reload(self):
        self.instances = self.clock.update(discover())
        self.draw()

    def visible(self):
        # idle first, and within a state the one stuck there longest on top
        key = ((lambda i: (STATE_ORDER[i.state], i.since)) if self.sort == "state"
               else (lambda i: (i.short_path, i.pid)))
        if not self.filter:
            return sorted(self.instances, key=key)
        needle = self.filter.lower()
        scored = []
        for i in self.instances:
            hits = [h for h in (fuzzy(needle, i.short_path), fuzzy(needle, i.summary)) if h]
            if hits:
                scored.append((min(s for s, _ in hits), i))
        # a filter outranks the sort: you typed those keys to reach one row, so the
        # closest match goes on top and enter takes it
        return [i for _, i in sorted(scored, key=lambda p: (p[0], key(p[1])))]

    def mark(self, text, style):
        """Paint the matched characters, so a loose match shows what it matched on."""
        out = Text(text, style=style)
        hit = fuzzy(self.filter.lower(), text) if self.filter else None
        for i in hit[1] if hit else ():
            out.stylize(KEY, i, i + 1)
        return out

    def draw(self):
        table = self.query_one(Table)
        # follow the instance under the cursor, not the row number: sorting by state
        # reorders rows as instances change state, and the cursor would drift
        under = self.rows[table.cursor_row].pid if 0 <= table.cursor_row < len(self.rows) else None
        self.rows = self.visible()
        table.clear()
        for inst in self.rows:
            mark, style = STATE[inst.state]
            table.add_row(
                Text(mark, style=style),
                Text(inst.age, style="#626262"),
                self.mark(inst.short_path, "#b8a0be"),
                self.mark(inst.summary, "#eeeeee" if inst.state == "waiting" else "#9a9aa0"),
            )
        if self.rows:
            keep = next((n for n, i in enumerate(self.rows) if i.pid == under), None)
            table.move_cursor(row=keep if keep is not None else 0)

        waiting = sum(i.state == "waiting" for i in self.instances)
        self.title = f"claude code · {len(self.instances)} running"
        self.query_one("#search", Static).update(
            Text(f"/{self.filter}", style="#ceaadf") if self.filter
            else Text("type to filter", style="#4a4a55"))
        count = (f"{len(self.rows)} of {len(self.instances)} running" if self.filter
                 else f"{len(self.instances)} running")
        self.query_one("#status", Static).update(Text.assemble(
            (count, "#b8a0be"),
            ((f", {waiting} waiting", "bold #ceaadf") if waiting else ("", "")),
            (f"  ·  by {self.sort}", "#b8a0be")))

    # any printable key filters; nothing else in the app consumes plain characters
    def on_key(self, event):
        if event.key == "backspace":
            self.filter = self.filter[:-1]
        elif event.character and event.character.isprintable():
            self.filter += event.character
        else:
            return
        event.stop()
        self.draw()

    def action_quit(self):
        """Leave without Textual's shutdown, which costs ~200ms of waiting.

        `App.exit()` ends in `LinuxDriver.disable_input`, which joins the input thread;
        that thread polls stdin with a 0.1s timeout and then polls once more on the way
        out, so the join alone measures 0.205s. Undoing application mode is only the
        writes below plus `tcsetattr`, so do them and go: 0.36s to 0.12s. What is left is
        tmux hiding kitty's keyboard protocol from us (`extended-keys off`), so a bare
        ESC is ambiguous and Textual's parser waits ~100ms for the rest of a sequence.

        Every attribute touched here is Textual-private; if an upgrade moves one, fall
        back to the slow exit rather than leaving the terminal in application mode.
        """
        driver = self._driver
        try:
            driver._disable_bracketed_paste()
            driver._enable_line_wrap()
            driver._disable_in_band_window_resize()
            driver._disable_mouse_support()
            driver.write("\x1b[<u")      # kitty keyboard protocol off, before alt screen
            driver.write("\x1b[?1049l")  # leave the alt screen
            driver.write("\x1b[?25h")    # show the cursor
            driver.write("\x1b[?1004l")  # FocusIn/FocusOut off
            if driver.attrs_before is not None:
                with contextlib.suppress(termios.error):
                    termios.tcsetattr(driver.fileno, termios.TCSANOW, driver.attrs_before)
            driver._writer_thread.stop()  # drains the write queue, then joins
        except Exception:
            self.exit()
            return
        for cleanup in ON_EXIT:
            cleanup()
        os._exit(0)

    def action_cycle_sort(self):
        self.sort = SORTS[(SORTS.index(self.sort) + 1) % len(SORTS)]
        self.draw()

    def action_jump(self):
        """Focus the picked instance and stay open. Only escape quits."""
        row = self.query_one(Table).cursor_row
        if 0 <= row < len(self.rows):
            if err := jump(self.rows[row]):        # silent on success, toast on failure
                self.notify(err, severity="warning", timeout=2)

    def on_data_table_row_selected(self, event: DataTable.RowSelected):
        self.action_jump()

    def on_data_table_header_selected(self, event: DataTable.HeaderSelected):
        if (label := str(event.label)) in SORTS:      # clicking a header sorts by it
            self.sort = label
            self.draw()


# ---------------------------------------------------------------------------- cli

def cmd_ui():
    with tmux_window_name("ccjump"), kitty_window_title("ccjump"):
        CCJump().run()


def cmd_list():
    for i in StateClock().update(discover()):
        print(f"{STATE[i.state][0]:<6} {i.age:>4}  {i.short_path:<30} {i.summary}")


def cmd_doctor():
    print(f"TMUX={os.environ.get('TMUX', '(none)')}  "
          f"KITTY_WINDOW_ID={os.environ.get('KITTY_WINDOW_ID', '(none)')}")
    print(f"tmux allow-passthrough: {sh('tmux', 'show', '-gv', 'allow-passthrough').strip()}")
    for i in discover():
        print(f"  pid {i.pid} pane {i.pane or '-'} session {i.session or '-'} "
              f"state {i.state} match {i.match or '(unresolved)'}")


def cmd_focus(pid=None):
    for i in discover():
        if str(i.pid) == pid:
            if err := jump(i):
                print(err, file=sys.stderr)
            return
    print(f"no claude instance with pid {pid}", file=sys.stderr)


COMMANDS = {"ui": cmd_ui, "list": cmd_list, "doctor": cmd_doctor, "focus": cmd_focus}

if __name__ == "__main__":
    name, *rest = sys.argv[1:] or ["ui"]
    if name not in COMMANDS:
        sys.exit(f"usage: ccjump [{' | '.join(COMMANDS)}]")
    COMMANDS[name](*rest)
