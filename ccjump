#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["textual"]
# ///
"""Pick a running Claude Code instance and focus its kitty window + tmux pane.

The UI and the CLI that dispatches it. The listing and the jump itself live in
claudes.py, which is stdlib-only and knows nothing about how any of it is drawn.

    ./ccjump              # the TUI
    ./ccjump list         # plain listing
    ./ccjump doctor       # what resolves, and the kitty match it would use
    ./ccjump focus <pid>  # jump without the UI
"""

import contextlib
import os
import sys
import termios

from rich.text import Text
from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import Horizontal
from textual.theme import Theme
from textual.widgets import DataTable, Rule, Static

from claudes import (ON_EXIT, SORTS, StateClock, discover, fuzzy, jump,
                     kitty_window_title, play, rank, session_records, sh,
                     tmux_window_name)

# ----------------------------------------------------------------------------- ui

# Built from ~/.config/kitty/kitty.conf so the app matches the terminal it runs in:
# color13 #ceaadf (bright purple), color5 #b8a0be (mauve), background #000.
PURPLE = Theme(
    name="ccjump",
    primary="#ceaadf",
    secondary="#b8a0be",
    accent="#ceaadf",
    foreground="#eeeeee",
    background="#000000",
    surface="#0e0b12",
    panel="#181020",
    warning="#eccd58",
    error="#df6565",
    success="#c4d15b",
    dark=True,
)

# #ffd700 is xterm 220, the exact color Claude Code paints "⏵⏵ auto mode on" with
# (read off a live pane as `ESC[38;5;220m`), so the two agree on what wants you
STATE = {
    "wait": ("● wait", "#ffd700"),
    "free": ("◌ free", "#626262"),
    "busy": ("◐ busy", "#80c9be"),
}
KEY = "bold #ceaadf"
KEYS = Text.assemble(("1-0", KEY), "/", ("enter", KEY), " jump   ",
                     ("esc", KEY), " quit   ", ("^s", KEY), " sort")

# the digits label the first ten rows, in the order they are drawn
NUMBERS = "1234567890"


class Table(DataTable):
    BINDINGS = [Binding("enter", "select_cursor", "jump", show=True)]

    def on_click(self, event):
        """Select on the first click. DataTable moves the cursor on click and only
        selects on a second click; its own `_on_click` has already run by now, so the
        cursor is on the clicked row. Cell meta carries row -1 for the header."""
        if event.style.meta.get("row", -1) >= 0:
            self.action_select_cursor()


class CCJump(App):
    CSS = """
    Screen { background: $background; }
    #bar { height: 1; background: $panel; }
    #search { width: 1fr; padding: 0 1; }
    #status { width: auto; padding: 0 2; color: $secondary; }
    #keys { width: auto; padding: 0 1; }
    Rule { height: 1; margin: 0; color: #35284a; }
    Table { height: 1fr; padding: 0 1; background: $background; scrollbar-size-horizontal: 0; }
    Table > .datatable--cursor { background: #2a1e38; text-style: bold; }
    Table > .datatable--header { background: $background; color: $secondary; }
    """
    ENABLE_COMMAND_PALETTE = False
    BINDINGS = [
        Binding("escape", "quit", "quit"),
        # App binds ctrl+c to `help_quit`, which only toasts "Press ctrl+q to quit the
        # app". Every key that reads as "leave" leaves: ctrl+c, ctrl+q (App's own
        # priority binding, which reaches action_quit below) and escape
        Binding("ctrl+c", "quit", "quit", show=False, priority=True),
        Binding("ctrl+s", "cycle_sort", "sort"),
    ]

    def __init__(self):
        super().__init__()
        self.clock = StateClock()
        self.instances = []
        self.rows = []
        self.filter = ""
        self.sort = SORTS[0]

    def compose(self) -> ComposeResult:
        with Horizontal(id="bar"):
            yield Static(id="search")
            yield Static(id="status")
            yield Static(KEYS, id="keys")
        yield Rule(line_style="solid")
        # cursor_foreground_priority: the cursor row keeps a cell's own color instead of
        # flattening it to $block-cursor-foreground, so wait stays yellow when selected
        yield Table(cursor_type="row", zebra_stripes=False,
                    cursor_foreground_priority="renderable")

    def on_mount(self):
        self.register_theme(PURPLE)
        self.theme = "ccjump"
        table = self.query_one(Table)
        table.add_column("", width=1)          # the digit that jumps to the row
        table.add_column("state", width=6)
        table.add_column("for", width=5)
        table.add_column("path", width=26)
        table.add_column("summary")
        self.reload()
        self.set_interval(1.5, self.reload)

    def reload(self):
        self.instances = self.clock.update(discover())
        if self.clock.woke:          # one sound per pass, not one per instance
            play()
        self.draw()

    @property
    def needle(self):
        """What is actually matched: the filter with its ends trimmed. A leading space
        is how you search for something starting with a digit, since a digit typed into
        an *empty* filter picks a row instead; " 3" then matches the same as "3"."""
        return self.filter.strip().lower()

    def mark(self, text, style):
        """Paint the matched characters, so a loose match shows what it matched on."""
        out = Text(text, style=style)
        hit = fuzzy(self.needle, text) if self.needle else None
        for i in hit[1] if hit else ():
            out.stylize(KEY, i, i + 1)
        return out

    def draw(self):
        table = self.query_one(Table)
        # follow the instance under the cursor, not the row number: sorting by state
        # reorders rows as instances change state, and the cursor would drift
        under = self.rows[table.cursor_row].pid if 0 <= table.cursor_row < len(self.rows) else None
        self.rows = rank(self.instances, self.needle, self.sort)
        table.clear()
        for n, inst in enumerate(self.rows):
            mark, style = STATE[inst.state]
            table.add_row(
                Text(NUMBERS[n] if n < len(NUMBERS) else " ", style="#626262"),
                Text(mark, style=style),
                Text(inst.age, style="#626262"),
                self.mark(inst.short_path, "#b8a0be"),
                self.mark(inst.summary, "#eeeeee" if inst.state == "wait" else "#9a9aa0"),
            )
        if self.rows:
            keep = next((n for n, i in enumerate(self.rows) if i.pid == under), None)
            table.move_cursor(row=keep if keep is not None else 0)

        waiting = sum(i.state == "wait" for i in self.instances)
        self.title = f"claude code · {len(self.instances)} running"
        self.query_one("#search", Static).update(
            Text(f"/{self.filter}", style="#ceaadf") if self.filter
            else Text("type to filter", style="#4a4a55"))
        count = (f"{len(self.rows)} of {len(self.instances)}" if self.filter
                 else f"{waiting}/{len(self.instances)}")
        self.query_one("#status", Static).update(Text.assemble(
            (count, "bold #ffd700" if waiting and not self.filter else "#b8a0be"),
            (f"  ·  by {self.sort}", "#b8a0be")))

    # a digit typed into an empty filter picks its row; any other printable key filters
    def on_key(self, event):
        if not self.filter and event.character and event.character in NUMBERS:
            event.stop()
            self.jump_row(NUMBERS.index(event.character))
            return
        if event.key == "backspace":
            self.filter = self.filter[:-1]
        elif event.character and event.character.isprintable():
            self.filter += event.character
        else:
            return
        event.stop()
        self.draw()

    def action_quit(self):
        """Leave without Textual's shutdown, which costs ~200ms of waiting.

        `App.exit()` ends in `LinuxDriver.disable_input`, which joins the input thread;
        that thread polls stdin with a 0.1s timeout and then polls once more on the way
        out, so the join alone measures 0.205s. Undoing application mode is only the
        writes below plus `tcsetattr`, so do them and go: 0.36s to 0.12s. What is left is
        tmux hiding kitty's keyboard protocol from us (`extended-keys off`), so a bare
        ESC is ambiguous and Textual's parser waits ~100ms for the rest of a sequence.

        Every attribute touched here is Textual-private; if an upgrade moves one, fall
        back to the slow exit rather than leaving the terminal in application mode.
        """
        driver = self._driver
        try:
            driver._disable_bracketed_paste()
            driver._enable_line_wrap()
            driver._disable_in_band_window_resize()
            driver._disable_mouse_support()
            driver.write("\x1b[<u")      # kitty keyboard protocol off, before alt screen
            driver.write("\x1b[?1049l")  # leave the alt screen
            driver.write("\x1b[?25h")    # show the cursor
            driver.write("\x1b[?1004l")  # FocusIn/FocusOut off
            if driver.attrs_before is not None:
                with contextlib.suppress(termios.error):
                    termios.tcsetattr(driver.fileno, termios.TCSANOW, driver.attrs_before)
            driver._writer_thread.stop()  # drains the write queue, then joins
        except Exception:
            self.exit()
            return
        for cleanup in ON_EXIT:
            cleanup()
        os._exit(0)

    def action_cycle_sort(self):
        self.sort = SORTS[(SORTS.index(self.sort) + 1) % len(SORTS)]
        self.draw()

    def jump_row(self, row):
        """Focus that instance and stay open. Only a quit key quits."""
        if not 0 <= row < len(self.rows):
            return
        self.query_one(Table).move_cursor(row=row)   # so the cursor shows what was taken
        if err := jump(self.rows[row]):              # silent on success, toast on failure
            self.notify(err, severity="warning", timeout=2)

    def action_jump(self):
        self.jump_row(self.query_one(Table).cursor_row)

    def on_data_table_row_selected(self, event: DataTable.RowSelected):
        self.action_jump()

    def on_data_table_header_selected(self, event: DataTable.HeaderSelected):
        if (label := str(event.label)) in SORTS:      # clicking a header sorts by it
            self.sort = label
            self.draw()


# ---------------------------------------------------------------------------- cli

def cmd_ui():
    with tmux_window_name("ccjump"), kitty_window_title("ccjump"):
        CCJump().run()


def cmd_list():
    for i in StateClock().update(discover()):
        print(f"{STATE[i.state][0]:<6} {i.age:>4}  {i.short_path:<30} {i.summary}")


def cmd_doctor():
    print(f"TMUX={os.environ.get('TMUX', '(none)')}  "
          f"KITTY_WINDOW_ID={os.environ.get('KITTY_WINDOW_ID', '(none)')}")
    print(f"tmux allow-passthrough: {sh('tmux', 'show', '-gv', 'allow-passthrough').strip()}")
    records = session_records()
    for i in discover():
        rec = records.get(i.pid, {})
        print(f"  pid {i.pid} pane {i.pane or '-'} session {i.session or '-'} "
              f"state {i.state or '?'} record {rec.get('status', '(none)')}"
              f"{'/' + rec['waitingFor'] if rec.get('waitingFor') else ''} "
              f"match {i.match or '(unresolved)'}")


def cmd_focus(pid=None):
    for i in discover():
        if str(i.pid) == pid:
            if err := jump(i):
                print(err, file=sys.stderr)
            return
    print(f"no claude instance with pid {pid}", file=sys.stderr)


COMMANDS = {"ui": cmd_ui, "list": cmd_list, "doctor": cmd_doctor, "focus": cmd_focus}

if __name__ == "__main__":
    name, *rest = sys.argv[1:] or ["ui"]
    if name not in COMMANDS:
        sys.exit(f"usage: ccjump [{' | '.join(COMMANDS)}]")
    COMMANDS[name](*rest)
