async function cmdFocus(pid) {
  for (const i of await discover()) {
    if (String(i.pid) !== pid) continue;
    const err = await jump(i);
    if (!err) return;
    console.error(err);
    Deno.exit(1);
  }
  console.error(`no claude instance with pid ${pid}`);
  Deno.exit(1);
